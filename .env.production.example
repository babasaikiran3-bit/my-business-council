# ============================================
# Eternal Ops Control - PRODUCTION Environment
# ============================================
# Use this configuration for production deployment
# In Vercel: Set these as "Production" environment variables
#
# ⚠️  SECURITY: Never commit actual production credentials!

ENV=production

# ============================================
# OpenRouter API (Required)
# ============================================
OPENROUTER_API_KEY=your_production_openrouter_api_key_here

# ============================================
# Supabase Configuration (Production)
# ============================================
# Production database: prod-eternal-ops-control (eu-west-1)
# Project ID: vthibdgqnxfbjrscxdlf
SUPABASE_URL=https://vthibdgqnxfbjrscxdlf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# ============================================
# WorkOS Authentication (Production Environment)
# ============================================
# ⚠️  Production uses DIFFERENT credentials from staging!
# Get these from https://dashboard.workos.com (Production environment)
# Note: Production API keys start with sk_live_ (not sk_test_)
WORKOS_API_KEY=sk_live_your_production_key_here
WORKOS_CLIENT_ID=client_your_production_client_id_here

# Email domain for access control
EMPLOYEE_EMAIL_DOMAIN=eternal.ag

# Optional: Partner domains for external collaborators
# ALLOWED_PARTNER_DOMAINS=partner1.com,partner2.com

# ============================================
# CORS Configuration
# ============================================
# Set to your production domain(s)
ALLOWED_ORIGINS=https://your-production-domain.com

