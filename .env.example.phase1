# OpenRouter Configuration (Required)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Rube MCP Server Configuration (Required for Phase 1)
# Get your API key at https://rube.app
RUBE_MCP_URL=https://rube.app/mcp
RUBE_API_KEY=your_rube_api_key_here

# Linear Configuration (Required for Phase 1)
# Get your team ID from Linear settings
LINEAR_TEAM_ID=your_linear_team_id_here

