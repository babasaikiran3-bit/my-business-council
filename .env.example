# =============================================================================
# LLM Council - API Keys Configuration
# =============================================================================
# Copy this file to .env and fill in the keys for the providers you want to use.
#
# HOW ROUTING WORKS:
#   - If a direct API key exists for a model's provider, it uses the native API.
#   - If not, it falls back to OpenRouter (requires OPENROUTER_API_KEY).
#   - You can mix and match: e.g. use OpenAI directly but route Gemini via OpenRouter.
#
# You only need to set keys for providers you actually use. At minimum, set
# either individual provider keys OR OPENROUTER_API_KEY as a catch-all.
# =============================================================================

# --- Direct Provider Keys (optional, preferred for lower latency/cost) ---

# OpenAI (gpt-4o, gpt-5.1, o1, etc.)
# OPENAI_API_KEY=sk-...

# Anthropic (claude-sonnet-4.5, claude-opus-4, etc.)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (gemini-3-pro-preview, gemini-2.5-flash, etc.)
# GEMINI_API_KEY=...

# xAI (grok-4, etc.)
# XAI_API_KEY=xai-...

# DeepSeek (deepseek-chat, deepseek-reasoner, etc.)
# DEEPSEEK_API_KEY=sk-...

# --- OpenRouter (fallback for any model without a direct key) ---
# OPENROUTER_API_KEY=sk-or-v1-...
