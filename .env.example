# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Council Configuration
# Comma-separated list of model identifiers to use as council members
# Leave blank to use defaults: gpt-5.1, gemini-3-pro-preview, claude-sonnet-4.5, grok-4
COUNCIL_MODELS=

# Model to use as chairman for final synthesis
# Leave blank to use default: gemini-3-pro-preview
CHAIRMAN_MODEL=

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Storage
# Directory for conversation data
DATA_DIR=data/conversations

# Example custom configuration:
# COUNCIL_MODELS=openai/gpt-4o,anthropic/claude-3.5-sonnet,google/gemini-pro
# CHAIRMAN_MODEL=anthropic/claude-3.5-sonnet
# LOG_LEVEL=DEBUG
