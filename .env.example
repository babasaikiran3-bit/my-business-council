# Parenting Roundtable — backend environment (copy to .env; .env is gitignored)
# Generate a strong secret:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- Required ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...                 # paid LLM access (OpenRouter)
SESSION_SECRET=                              # REQUIRED in production: random, >=32 chars (fail-fast if missing)

# --- Environment / deployment ----------------------------------------------
ENVIRONMENT=dev                              # "production" turns on Secure/SameSite=None cookies, HSTS, strict CORS + secret fail-fast
DATA_DIR=data/conversations                  # PRODUCTION: an absolute path on a PERSISTENT disk (e.g. /data/conversations) — a PaaS ephemeral FS loses data on redeploy
STORAGE_BACKEND=json                         # only "json" for the pilot (Postgres is a future drop-in)

# --- CORS / frontend (credentialed cross-site: list explicit origins, never "*") -------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # PRODUCTION: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173           # PRODUCTION: must be an https origin present in CORS_ORIGINS
REQUIRE_AUTH_FOR_MESSAGES=                    # blank = on in production, off in dev; "true"/"false" to force

# --- Cost & abuse knobs (generous pilot defaults) --------------------------
MAX_REQUEST_BYTES=200000
MAX_MESSAGE_CHARS=5000
RATE_LIMIT_MESSAGES=10/minute
RATE_LIMIT_AUTH=30/minute
QUOTA_DAILY_MESSAGES=50

# --- Orchestration timeouts (seconds; per-stage sum must stay < PIPELINE_TIMEOUT) ------
STAGE0_TIMEOUT=60
STAGE1_TIMEOUT=90
STAGE2_TIMEOUT=90
STAGE3_TIMEOUT=90
TITLE_TIMEOUT=30
PIPELINE_TIMEOUT=360

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- OAuth (optional; each provider is disabled until its id + redirect are set) -------
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=                          # PRODUCTION: https://api.yourdomain.com/api/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=                          # PRODUCTION: https://api.yourdomain.com/api/auth/naver/callback
