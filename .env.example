# API Keys for LLM Providers
# Copy this file to .env and fill in your actual API keys

# Anthropic (Claude) - Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# OpenAI (GPT) - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_key_here

# Google (Gemini) - Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIyour_key_here
