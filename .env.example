OLLAMA_API_URL=http://localhost:11434/api/chat

# Select exactly one backend: api or ollama
PROVIDER=ollama

# API backend (OpenRouter-compatible)
OPENROUTER_API_KEY=
API_COUNCIL_MODELS=openai/gpt-5.1,google/gemini-2.5-flash
API_JUDGE_MODELS=openai/gpt-5.1,google/gemini-2.5-flash
API_CHAIRMAN_MODEL=google/gemini-2.5-flash
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Local Ollama backend (Windows default)
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_COUNCIL_MODELS=llama3.2:3b,qwen3.5:2b,phi4-mini:latest
OLLAMA_JUDGE_MODELS=llama3.2:3b,qwen3.5:2b,phi4-mini:latest
OLLAMA_CHAIRMAN_MODEL=phi4-mini:latest
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=120

# Optional local retrieval
RAG_ENABLED=false
RAG_DOCUMENTS_DIR=data/documents
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Shared settings
COUNCIL_LITE_MODE=true
# TITLE_MODEL=phi4-mini:latest
