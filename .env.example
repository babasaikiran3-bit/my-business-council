# LLM Council Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenRouter API Key for LLM queries
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Allowed origins for CORS (comma-separated)
# If not set, defaults to localhost:5173 and localhost:3000
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# WorkOS Authentication (Required for production)
# ============================================
# Get these from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_xxxxx
WORKOS_CLIENT_ID=client_xxxxx

# Email Domain Validation
# Only users with emails ending in this domain can access the application
EMPLOYEE_EMAIL_DOMAIN=eternal.ag

# Optional: Partner domains for external collaborators (comma-separated)
# ALLOWED_PARTNER_DOMAINS=partner1.com,partner2.com

# Optional: Webhook secret for WorkOS events
# WORKOS_WEBHOOK_SECRET=xxxxx

# ============================================
# Vercel Configuration
# ============================================
# Vercel automatically sets these in production:
# VERCEL_URL - The deployment URL (e.g., your-project.vercel.app)
# VERCEL - Set to "1" when running on Vercel

