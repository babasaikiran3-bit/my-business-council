# ============================================
# Eternal Ops Control - STAGING Environment
# ============================================
# Use this configuration for staging/preview deployments
# In Vercel: Set these as "Preview" environment variables

ENV=staging

# ============================================
# OpenRouter API (Required)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Supabase Configuration (Staging)
# ============================================
# Project: staging-eternal-ops-control (ID: ggfwstjrjckkecchxjhp)
# Region: eu-west-2
SUPABASE_URL=https://ggfwstjrjckkecchxjhp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_here

# ============================================
# WorkOS Authentication (Staging Environment)
# ============================================
# Staging uses WorkOS staging credentials (same as development)
# Get these from https://dashboard.workos.com (Staging environment)
WORKOS_API_KEY=sk_test_your_staging_key_here
WORKOS_CLIENT_ID=client_01KCFAGT072SD33WQKKT0S4T04

# Email domain for access control
EMPLOYEE_EMAIL_DOMAIN=eternal.ag

# ============================================
# CORS Configuration
# ============================================
# Add your staging domain here
# Vercel preview URLs are automatically allowed via regex
ALLOWED_ORIGINS=https://staging.your-domain.com

