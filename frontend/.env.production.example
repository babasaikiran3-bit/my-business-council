# ============================================
# Eternal Ops Control Frontend - PRODUCTION Environment
# ============================================
# Use this configuration for production deployment
# In Vercel: Set these as "Production" environment variables
#
# ⚠️  Production uses DIFFERENT WorkOS credentials from staging!

# WorkOS AuthKit Configuration (Production)
# Must match WORKOS_CLIENT_ID from root .env.production
VITE_WORKOS_CLIENT_ID=client_your_production_client_id_here
VITE_WORKOS_REDIRECT_URI=https://your-production-domain.com/callback

# Optional: Override API base URL
# VITE_API_BASE_URL=https://api.your-production-domain.com

