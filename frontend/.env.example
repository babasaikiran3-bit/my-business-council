# WorkOS AuthKit Configuration
# Get these values from your WorkOS Dashboard: https://dashboard.workos.com

# Required: WorkOS Client ID (starts with "client_")
VITE_WORKOS_CLIENT_ID=client_xxxxx

# Required: OAuth callback URL (must match WorkOS dashboard configuration)
# Development: http://localhost:5173/callback
# Production: https://your-domain.com/callback
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Optional: API base URL (defaults to http://localhost:8001 in development)
# VITE_API_BASE_URL=http://localhost:8001

# Optional: Employee email domain for display purposes
VITE_EMPLOYEE_EMAIL_DOMAIN=eternal.ag

# Feature Flags
# Enable the new Eternal Ops Control dashboard layout (default: true)
# Set to 'true' for the multi-feature dashboard, 'false' for legacy single-feature UI
VITE_ENABLE_DASHBOARD=true
