# Frontend build-time env (copy to .env.local for dev; set in Vercel/Netlify for prod).
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# Backend API base URL. Dev default is http://localhost:8001.
# Production: set to your deployed backend, e.g. https://api.yourdomain.com
VITE_API_BASE=http://localhost:8001
