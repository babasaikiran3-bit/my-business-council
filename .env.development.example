# ============================================
# Eternal Ops Control - DEVELOPMENT Environment
# ============================================
# Copy this file to .env for local development
# cp .env.development.example .env

ENV=development

# ============================================
# OpenRouter API (Required)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Supabase Configuration (Development)
# ============================================
# Project: dev-eternal-ops-control (ID: logtcdlczkdkglxmosyz)
# Region: eu-central-1
SUPABASE_URL=https://logtcdlczkdkglxmosyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here

# ============================================
# WorkOS Authentication (Staging Environment)
# ============================================
# Development uses WorkOS staging credentials
# Get these from https://dashboard.workos.com (Staging environment)
WORKOS_API_KEY=sk_test_your_staging_key_here
WORKOS_CLIENT_ID=client_01KCFAGT072SD33WQKKT0S4T04

# Email domain for access control
EMPLOYEE_EMAIL_DOMAIN=eternal.ag

# ============================================
# CORS Configuration
# ============================================
# For local development, these are the defaults
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

